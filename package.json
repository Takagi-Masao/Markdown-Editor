{
  "name": "markdown-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run check && npm run test:smoke && npm run test:regression",
    "test:smoke": "node tests/browser-smoke.mjs",
    "test:regression": "npm run test:regression:unit && node tests/browser-regression.mjs",
    "test:regression:unit": "node --test --test-isolation=none tests/regression.test.mjs",
    "check": "node tests/check-syntax.mjs"
  },
  "engines": { "node": ">=22.15.0" }
}
